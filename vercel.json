{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "regions": ["cdg1"],
  "outputDirectory": ".next",
  "installCommand": "npm install --legacy-peer-deps",
  "crons": [
    {
      "path": "/api/cron/retour-inactif",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/defi-du-mois",
      "schedule": "0 9 1 * *"
    }
  ]
}
