  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "env": {
    "BREVO_API_KEY": "@brevo_api_key",
    "PAYHIP_API_KEY": "@payhip_api_key",
